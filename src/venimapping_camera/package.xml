<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>venimapping_camera</name>
  <version>0.1.0</version>
  <description>
    Camera gateway for VeniMapping: a ROS-independent camera contract and its
    concrete implementation over the vimbax_ros2_driver services.
  </description>
  <maintainer email="lkaising@outlook.com">Logan Kaising</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>vimbax_camera_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
