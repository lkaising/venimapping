import os
import signal
import sys
import time
from pathlib import Path

name = "decoy.pid" if os.environ.get("PLANRUN_DECOY") else "driver.pid"
pid_file = Path(os.environ["PLANRUN_FAKE_STATE"]) / name
pid_file.write_text(str(os.getpid()))


def leave(signum, frame):
    pid_file.unlink(missing_ok=True)
    sys.exit(0)


signal.signal(signal.SIGINT, leave)
signal.signal(signal.SIGTERM, leave)
while True:
    time.sleep(0.2)
